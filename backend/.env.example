# Copy this file to `.env` and fill in real values.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.8.172

# MySQL database (match what you created in MySQL)
DB_NAME=pubg_food_truck
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.8.172:3000

# Google OAuth ("Sign in with Google")
# Create a Web-application OAuth Client ID in Google Cloud Console and
# paste it here (and the same value into frontend/.env as REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_OAUTH_CLIENT_ID=
